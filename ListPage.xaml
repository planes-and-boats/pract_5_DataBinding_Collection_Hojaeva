<Page x:Class="pract_5_Hojaeva.ListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pract_5_Hojaeva" d:DataContext="{d:DesignInstance Type=local:Training}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ListPage" Background="Azure">

    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.Resources>
            <Style TargetType="Label">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="Margin" Value="5"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="Margin" Value="10"/>
                <Setter Property="Padding" Value="5"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Background" Value="AliceBlue"/>
            </Style>
            <Style TargetType="ListView">
                <Setter Property="Margin" Value="10"/>
                <Setter Property="FontSize" Value="16"/>
            </Style>
            <Style TargetType="StackPanel">
                <Setter Property="Margin" Value="10"/>
            </Style>
        </Grid.Resources>

        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                    Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Тренировки"/>
        </StackPanel>

        <ListView x:Name="lvTraining" Grid.Column="0" Grid.Row="1" ItemsSource="{Binding Training}">

            <ListView.ItemTemplate>
                <DataTemplate>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Column="0" Grid.Row="0" Content="Идентификатор: "/>
                        <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding ID}"/>

                        <Label Grid.Column="0" Grid.Row="1" Content="Название: "/>
                        <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Name}"/>

                        <Label Grid.Column="0" Grid.Row="2" Content="Дата: "/>
                        <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding Date, StringFormat=dd.MM.yyyy}"/>

                        <Label Grid.Column="0" Grid.Row="3" Content="Тип: "/>
                        <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding Type}"/>


                        <Label Grid.Column="0" Grid.Row="4" Content="Продолжительность (мин): "/>
                        <TextBlock Grid.Column="1" Grid.Row="4" Text="{Binding WorkoutDurationMinutes}"/>

                    </Grid>
                    
                    <!--<StackPanel Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Идентификатор: "/>
                            <TextBlock Text="{Binding ID}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Название: "/>
                            <TextBlock Text="{Binding Name}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Дата: "/>
                            <TextBlock Text="{Binding Date, StringFormat=dd.MM.yyyy}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Тип: "/>
                            <TextBlock Text="{Binding Type}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Продолжительность (мин): "/>
                            <TextBlock Text="{Binding WorkoutDurationMinutes}"/>
                        </StackPanel>
                    </StackPanel>-->
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Column="1" Grid.Row="1"
                    Orientation="Vertical" VerticalAlignment="Center">
            <Button x:Name="btnAdd" Content="Добавить" Click="btnAdd_Click"/>
            <Button x:Name="btnDelete" Content="Удалить" Click="btnDelete_Click"/>
            <Button x:Name="btnRed" Content="Редактировать" Click="btnRed_Click"/>
        </StackPanel>

        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2"
                    Orientation="Horizontal">
            <TextBlock Text="Всего в списке: "/>
            <Label Content="{Binding Training.Count}"/>
        </StackPanel>
        
    </Grid>
</Page>
