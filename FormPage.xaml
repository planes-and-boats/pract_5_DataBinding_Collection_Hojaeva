<Page x:Class="pract_5_Hojaeva.FormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pract_5_Hojaeva"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FormPage" Background="LightSteelBlue"  >

    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid.Resources>
            <Style TargetType="Label">
                <Setter Property="FontSize" Value="14"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Margin" Value="5"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
            </Style>
            <Style TargetType="DatePicker">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="5"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="Margin" Value="10"/>
                <Setter Property="Padding" Value="5"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Background" Value="AliceBlue"/>
            </Style>
            <Style TargetType="ListView">
                <Setter Property="Margin" Value="10"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            </Style>
            <Style TargetType="StackPanel">
                <Setter Property="Margin" Value="10"/>
            </Style>
        </Grid.Resources>
        
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
              Margin="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Grid.Row="0" Content="ID"/>
            <Label Grid.Column="0" Grid.Row="1" Content="Название"/>
            <Label Grid.Column="0" Grid.Row="2" Content="Дата"/>
            <Label Grid.Column="0" Grid.Row="3" Content="Тип"/>
            <Label Grid.Column="0" Grid.Row="4" Content="Продолжительность (мин)"/>

            <TextBox Grid.Column="1" Grid.Row="0" IsReadOnly="True" Text="{Binding ID, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            <DatePicker Grid.Column="1" Grid.Row="2" Text="{Binding Date, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding Type, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Grid.Column="1" Grid.Row="4" IsReadOnly="True" Text="{Binding WorkoutDurationMinutes, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>

        </Grid>

        <ListView x:Name="lvExercises" Grid.Column="0" Grid.Row="1" Margin="10" ItemsSource="{Binding Exercises}">

            <ListView.Resources>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.Resources>
            
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Column="0" Grid.Row="0" Content="Название: "/>
                        <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                        <Label Grid.Column="0" Grid.Row="1" Content="Количество подходов: "/>
                        <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding Sets, UpdateSourceTrigger=PropertyChanged}"/>

                        <Label Grid.Column="0" Grid.Row="2" Content="Время подхода (мин): "/>
                        <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding SetDurationMinutes, UpdateSourceTrigger=PropertyChanged}"/>

                        <Label Grid.Column="0" Grid.Row="3" Content="Продолжительность (мин): "/>
                        <TextBox Grid.Column="1" Grid.Row="3" IsReadOnly="True" Text="{Binding ExerciseDurationMinutes, Mode=OneWay}"/>

                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Column="1" Grid.Row="1"
                    Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Button x:Name="btnAddExercise" Content="Добавить упражнение" Click="btnAddExercise_Click"/>
            <Button x:Name="btnDeleteExercise" Content="Удалить упражнение" Click="btnDeleteExercise_Click"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="2"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnSave" Content="Сохранить" Click="btnSave_Click"/>
            <Button x:Name="btnBack" Content="Отмена" Click="btnBack_Click"/>
        </StackPanel>
        
    </Grid>
</Page>
